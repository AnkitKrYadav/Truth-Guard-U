# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# News and Fact-Checking APIs
NEWS_API_KEY=your_newsapi_key_here
FACTCHECK_API_KEY=your_google_factcheck_api_key_here

# HuggingFace API (for alternative AI model)
HF_API_KEY=your_huggingface_api_key_here

# Google Gemini API (for alternative AI model)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Configuration (optional)
MONGO_URI=your_mongodb_connection_string

# Application Settings
DEBUG=False  # Set to False for production
AI_MOCK=False  # Set to True to use mock AI responses for testing

# CORS Configuration
# Set this to your deployed frontend URL for CORS (e.g., https://your-frontend.onrender.com)
ALLOWED_ORIGIN=http://localhost:3000

# Admin Configuration
# Optional admin key to protect expert actions
ADMIN_KEY=your_admin_secret_key_here

# Reddit API Configuration (for trending news)
# Get these from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=Truth-Guard/1.0 by /u/yourusername

# Twitter API Configuration (for trending news, optional)
# Get from: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
